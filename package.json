{
  "name": "twynn",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @twynn/api\" \"npm run dev -w @twynn/web\" \"npm run dev -w @twynn/shared\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p packages/shared/tsconfig.json",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.20.5",
    "concurrently": "^8.2.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.0",
    "vitest": "^2.1.9"
  }
}
