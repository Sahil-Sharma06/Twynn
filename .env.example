# Local development defaults. Copy to .env (npm run setup does this for you).
TWYNN_API_PORT=3000
TWYNN_DB_URL=postgres://twynn_user:twynn_password@localhost:5432/twynn
TWYNN_REDIS_URL=redis://localhost:6379
TWYNN_LOG_LEVEL=info

# Any OpenAI-compatible provider. Callers send their provider key as the bearer token.
TWYNN_UPSTREAM_BASE_URL=https://api.openai.com/v1
TWYNN_UPSTREAM_TIMEOUT_MS=60000
TWYNN_UPSTREAM_MAX_RETRIES=2
TWYNN_EXACT_CACHE_TTL_SECONDS=86400
