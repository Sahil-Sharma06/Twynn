# Local development defaults. Copy to .env (npm run setup does this for you).
TWYNN_API_PORT=3000
TWYNN_DB_URL=postgres://twynn_user:twynn_password@localhost:5432/twynn
TWYNN_REDIS_URL=redis://localhost:6379
TWYNN_LOG_LEVEL=info

# 32 random bytes, base64. Encrypts provider keys at rest; npm run setup generates one.
# Generate manually with: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
TWYNN_ENCRYPTION_KEY=
# Dashboard origin; the only origin allowed to make state-changing dashboard API calls.
TWYNN_WEB_ORIGIN=http://localhost:5173
TWYNN_SESSION_TTL_DAYS=30

# Upstream provider calls (each workspace configures its own provider URL and key).
TWYNN_UPSTREAM_TIMEOUT_MS=60000
TWYNN_UPSTREAM_MAX_RETRIES=2
TWYNN_EMBEDDING_TIMEOUT_MS=10000
# Cache TTL, twin threshold and the embeddings model are per-workspace settings (/api/settings).
