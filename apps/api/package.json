{
  "name": "@twynn/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.1",
    "@node-rs/argon2": "^2.2.1",
    "@twynn/shared": "*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.6.2",
    "ioredis": "^6.0.0",
    "pg": "^8.13.0",
    "pino": "^10.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.1"
  }
}
